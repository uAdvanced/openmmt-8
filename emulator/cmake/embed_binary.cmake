# cmake -DIN=<file or empty> -DOUT=<file.cpp> -DSYMBOL=<name> -P embed_binary.cmake
# Writes namespace mmt8 { const unsigned char SYMBOL[]; const size_t SYMBOL##Size; }.
if(IN AND EXISTS "${IN}")
  file(READ "${IN}" hex HEX)
else()
  set(hex "")
endif()
string(LENGTH "${hex}" hex_len)
math(EXPR size "${hex_len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x..,){24})" "\\1\n" bytes "${bytes}")
if(size EQUAL 0)
  set(bytes "0")
endif()
set(text "// Generated from ${IN}; do not edit.\n#include <cstddef>\nnamespace mmt8 {\nextern const unsigned char ${SYMBOL}[];\nextern const size_t ${SYMBOL}Size;\nconst unsigned char ${SYMBOL}[] = {\n${bytes}\n};\nconst size_t ${SYMBOL}Size = ${size};\n}\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL text)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${text}")
